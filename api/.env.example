# Discord webhook URL (required)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# Discord user ID to mention on new submissions (optional)
# Get your ID: Discord Settings → Advanced → Developer Mode → Right-click your name → Copy User ID
DISCORD_USER_ID=123456789012345678

# Allowed origin for CORS (defaults to https://boukri.me)
ALLOWED_ORIGIN=https://boukri.me

# Port to run the API on (defaults to 8080)
PORT=8080
