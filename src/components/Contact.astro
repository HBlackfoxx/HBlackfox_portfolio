---
import { ContactForm } from './ContactForm';
import { Icon } from 'astro-icon/components';

// API URL - configure this for your Coolify deployment
const apiUrl = import.meta.env.PUBLIC_CONTACT_API_URL || 'http://localhost:8080';
---

<section id="contact" class="py-16">
    <h3 class="text-4xl font-bold mb-4 text-foreground">Contact</h3>
    <p class="text-muted-foreground mb-10 text-lg">
        Let's connect and discuss how we can work together.
    </p>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">
        <!-- Contact Form -->
        <ContactForm client:load apiUrl={apiUrl} />

        <!-- Contact Info -->
        <div class="space-y-6">
            <div class="flex items-start gap-4 p-4 rounded-xl border bg-card">
                <div class="p-3 rounded-lg bg-primary/10">
                    <Icon name="lucide:mail" class="w-6 h-6 text-primary" />
                </div>
                <div>
                    <h4 class="font-semibold text-foreground">Email</h4>
                    <a href="mailto:contact@boukri.me" class="text-muted-foreground hover:text-primary transition-colors">
                        contact@boukri.me
                    </a>
                </div>
            </div>

            <div class="flex items-start gap-4 p-4 rounded-xl border bg-card">
                <div class="p-3 rounded-lg bg-primary/10">
                    <Icon name="lucide:linkedin" class="w-6 h-6 text-primary" />
                </div>
                <div>
                    <h4 class="font-semibold text-foreground">LinkedIn</h4>
                    <a href="https://www.linkedin.com/in/mohamed-boukri-427b37189/" target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-primary transition-colors">
                        linkedin.com/in/mohamed-boukri
                    </a>
                </div>
            </div>

            <div class="flex items-start gap-4 p-4 rounded-xl border bg-card">
                <div class="p-3 rounded-lg bg-primary/10">
                    <Icon name="lucide:github" class="w-6 h-6 text-primary" />
                </div>
                <div>
                    <h4 class="font-semibold text-foreground">GitHub</h4>
                    <a href="https://github.com/HBlackfoxx" target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-primary transition-colors">
                        github.com/HBlackfoxx
                    </a>
                </div>
            </div>

            <div class="flex items-start gap-4 p-4 rounded-xl border bg-card">
                <div class="p-3 rounded-lg bg-primary/10">
                    <Icon name="lucide:map-pin" class="w-6 h-6 text-primary" />
                </div>
                <div>
                    <h4 class="font-semibold text-foreground">Location</h4>
                    <p class="text-muted-foreground">Poitiers, France</p>
                </div>
            </div>
        </div>
    </div>
</section>
