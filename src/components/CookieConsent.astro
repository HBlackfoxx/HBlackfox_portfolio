---
import { Button } from "@/components/ui/button";
import { Icon } from 'astro-icon/components';
---

<div id="cookie-consent" class="fixed bottom-0 left-0 right-0 bg-background border-t border-border shadow-lg transform translate-y-full transition-transform duration-300 z-50 hidden safe-area-bottom">
    <div class="container mx-auto max-w-6xl px-4 py-4 md:py-4">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
            <div class="flex items-start md:items-center gap-3 md:gap-4 flex-1">
                <div class="bg-primary/10 p-2 rounded-full flex-shrink-0">
                    <Icon name="lucide:cookie" class="w-5 h-5 md:w-6 md:h-6 text-primary" />
                </div>
                <p class="text-xs md:text-sm text-muted-foreground leading-relaxed">
                    We use cookies to analyze our traffic and improve your experience. By clicking "Accept", you agree to our use of cookies.
                    <a href="/privacy" class="text-primary hover:underline ml-1 underline md:no-underline">Privacy Policy</a>.
                </p>
            </div>
            <div class="flex items-center gap-2 w-full md:w-auto flex-shrink-0">
                <Button variant="outline" size="sm" id="cookie-decline" className="flex-1 md:flex-none">
                    Decline
                </Button>
                <Button size="sm" id="cookie-accept" className="flex-1 md:flex-none">
                    Accept
                </Button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Ensure banner is visible above mobile navigation */
    #cookie-consent {
        padding-bottom: env(safe-area-inset-bottom, 0);
    }
    
    /* Smooth animation */
    #cookie-consent.show {
        transform: translateY(0);
    }
</style>

<script is:inline>
    function initCookieConsent() {
        const banner = document.getElementById('cookie-consent');
        const acceptBtn = document.getElementById('cookie-accept');
        const declineBtn = document.getElementById('cookie-decline');

        if (!banner || !acceptBtn || !declineBtn) return;

        // Check if user has already made a choice
        const consent = localStorage.getItem('cookie_consent');

        if (!consent) {
            // Show banner with a slight delay for animation
            banner.classList.remove('hidden');
            setTimeout(() => {
                banner.classList.remove('translate-y-full');
            }, 100);
        }

        acceptBtn.addEventListener('click', () => {
            localStorage.setItem('cookie_consent', 'granted');
            hideBanner();
            // Dispatch event to trigger GA load
            window.dispatchEvent(new CustomEvent('cookie-consent-granted'));
        });

        declineBtn.addEventListener('click', () => {
            localStorage.setItem('cookie_consent', 'denied');
            hideBanner();
        });

        function hideBanner() {
            banner.classList.add('translate-y-full');
            setTimeout(() => {
                banner.classList.add('hidden');
            }, 300);
        }
    }

    // Initialize on page load
    initCookieConsent();

    // Re-initialize on Astro page swaps (if using ViewTransitions)
    document.addEventListener('astro:after-swap', initCookieConsent);
</script>
