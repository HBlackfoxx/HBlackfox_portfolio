---
import { ViewTransitions } from 'astro:transitions';
import '../styles/globals.css';
import { GoogleFontsOptimizer } from "astro-google-fonts-optimizer";
import { SEO } from "astro-seo";
import CookieConsent from '@/components/CookieConsent.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: string;
  twitterCreator?: string;
  twitterCard?: string;
  twitterSite?: string;
  siteName?: string;
}

const defaultTitle = "Mohamed Boukri - Industrial AI & Blockchain Specialist";
const defaultDescription = "Industrial Engineering graduate and Master's student in Data & AI at École Centrale de Lyon. Passionate about optimizing industrial processes, leveraging AI for predictive analytics, and securing blockchain systems through smart contract auditing. Experienced in data analysis, machine learning, and supply chain optimization.";
const defaultImage = "/og-image.png";
const defaultOgType = "website";
const defaultTwitterCreator = "@HBlackfoxx";
const defaultTwitterCard = "summary_large_image";
const defaultTwitterSite = "@HBlackfoxx";
const defaultSiteName = "Mohamed Boukri";

const {
  title = defaultTitle,
  description = defaultDescription,
  image = defaultImage,
  ogType = defaultOgType,
  twitterCreator = defaultTwitterCreator,
  twitterCard = defaultTwitterCard,
  twitterSite = defaultTwitterSite,
  siteName = defaultSiteName
} = Astro.props;

const siteUrl = "https://boukri.me"; // Replace with your actual site URL
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <SEO
      title={title}
      description={description}
      openGraph={{
        basic: {
          title: title,
          type: ogType,
          image: image,
        },
        image: {
          alt: title,
        },
        optional: {
          siteName: siteName,
          description: description,
        },
      }}
      twitter={{
        creator: twitterCreator,
        site: twitterSite,
        title: title,
        image: image,
        imageAlt: title,
        description: description,
      }}
      extend={{
        link: [
          { rel: "icon", href: "/favicon.svg", type: "image/svg+xml" },
          { rel: "manifest", href: "/manifest.json" },
          { rel: "canonical", href: `${siteUrl}${Astro.url.pathname}` }
        ],
        meta: [
          { name: "generator", content: Astro.generator },
          { name: "theme-color", content: "#000000" },
        ],
      }}
  />
  <ViewTransitions />
  <GoogleFontsOptimizer url="https://fonts.googleapis.com/css2?family=Red+Hat+Display:ital,wght@0,300..900;1,300..900&family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap" />
  <script is:inline>
    function getThemePreference() {
      if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
        return localStorage.getItem('theme');
      }
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    function setTheme(theme) {
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
      window.localStorage.setItem('theme', theme);
    }

    setTheme(getThemePreference());

    document.addEventListener('astro:after-swap', () => {
      setTheme(getThemePreference());
    });
  </script>

  <!-- Google Analytics 4 - Conditional Loading -->
  {import.meta.env.PUBLIC_GA_MEASUREMENT_ID && (
    <script define:vars={{ gaId: import.meta.env.PUBLIC_GA_MEASUREMENT_ID }} is:inline>
      window.gaId = gaId;
      
      function loadGA() {
        if (window.gaLoaded) return;
        window.gaLoaded = true;
        
        // Load GA script
        const script = document.createElement('script');
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`;
        document.head.appendChild(script);
        
        // Initialize GA
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', gaId);
      }
      
      // Check consent on page load
      const consent = localStorage.getItem('cookie_consent');
      if (consent === 'granted') {
        loadGA();
      }
      
      // Listen for consent event
      window.addEventListener('cookie-consent-granted', loadGA);
      
      // Re-check on page transitions
      document.addEventListener('astro:after-swap', () => {
        const consent = localStorage.getItem('cookie_consent');
        if (consent === 'granted') {
          loadGA();
        }
      });
    </script>
  )}

  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Mohamed Boukri",
      "url": "https://boukri.me",
      "description": "Portfolio and blog of Mohamed Boukri - Industrial AI & Blockchain Specialist"
    }
  </script>
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Mohamed Boukri",
      "url": "https://boukri.me",
      "image": "https://boukri.me/og-image.png",
      "jobTitle": "Industrial AI & Blockchain Specialist",
      "sameAs": [
        "https://github.com/HBlackfoxx",
        "https://www.linkedin.com/in/mohamed-boukri-427b37189/"
      ]
    }
  </script>
</head>
<body class="min-h-screen bg-background font-sans antialiased">
<div class="relative flex min-h-screen flex-col container mx-auto px-4 max-w-5xl">
  <div class="flex-1">
    <slot />
  </div>
</div>
<CookieConsent />
</body>
</html>