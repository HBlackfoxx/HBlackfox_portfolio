---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { Icon } from 'astro-icon/components';

const allPosts = await Astro.glob('./*.mdx');
const sortedPosts = allPosts
  .filter(post => {
      const filename = post.file.split(/[/\\]/).pop();
      return !post.frontmatter.draft && !filename?.startsWith('_');
  })
  .sort((a, b) => 
    new Date(b.frontmatter.publishDate).valueOf() - new Date(a.frontmatter.publishDate).valueOf()
  );

// Group by Year -> Month
const archive = {};
sortedPosts.forEach((post) => {
  const date = new Date(post.frontmatter.publishDate);
  const year = date.getFullYear();
  const month = date.toLocaleString('default', { month: 'long' });
  
  if (!archive[year]) archive[year] = {};
  if (!archive[year][month]) archive[year][month] = [];
  archive[year][month].push(post);
});

const years = Object.keys(archive).sort((a, b) => Number(b) - Number(a));
---

<BlogLayout title="Blog Archive" description="Complete archive of all blog posts">
  <div class="container mx-auto px-4 py-12 max-w-4xl">
    <header class="mb-12 text-center">
      <div class="inline-flex items-center justify-center p-3 rounded-full bg-primary/10 mb-4">
        <Icon name="lucide:archive" class="w-8 h-8 text-primary" />
      </div>
      <h1 class="text-4xl font-bold mb-4 font-alt">Archive</h1>
      <p class="text-muted-foreground">Browse all {sortedPosts.length} articles by date</p>
    </header>

    <div class="space-y-12">
      {years.map((year) => (
        <div class="relative pl-8 border-l-2 border-border">
          <span class="absolute -left-[9px] top-0 w-4 h-4 rounded-full bg-primary ring-4 ring-background"></span>
          <h2 class="text-3xl font-bold mb-8 font-alt">{year}</h2>
          
          <div class="space-y-8">
            {Object.keys(archive[year]).map((month) => (
              <div>
                <h3 class="text-xl font-semibold mb-4 text-muted-foreground flex items-center gap-2">
                  <Icon name="lucide:calendar" class="w-4 h-4" />
                  {month}
                </h3>
                <div class="grid gap-4">
                  {archive[year][month].map((post) => (
                    <a 
                      href={post.url}
                      class="group flex flex-col md:flex-row gap-4 p-4 rounded-xl hover:bg-muted/50 transition-colors"
                    >
                      <div class="flex-1">
                        <h4 class="text-lg font-bold group-hover:text-primary transition-colors mb-2">
                          {post.frontmatter.title}
                        </h4>
                        <p class="text-sm text-muted-foreground line-clamp-2">
                          {post.frontmatter.description}
                        </p>
                      </div>
                      <div class="text-xs text-muted-foreground whitespace-nowrap md:text-right">
                        <div>{new Date(post.frontmatter.publishDate).getDate()} {month}</div>
                        <div class="mt-1">{post.frontmatter.readingTime}</div>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</BlogLayout>
