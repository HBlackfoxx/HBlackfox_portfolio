---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer';
import { Icon } from 'astro-icon/components';
import { Card, CardHeader, CardTitle, CardDescription, CardContent, CardFooter } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { Button } from '@/components/ui/button';
import { Separator } from '@/components/ui/separator';
import { Image } from 'astro:assets';

// Get all blog posts
const allPosts = await Astro.glob('./*.{md,mdx}');

// Filter out drafts and sort by date
const posts = allPosts
    .filter(post => {
        const filename = post.file.split(/[/\\]/).pop();
        return !post.frontmatter.draft && !filename?.startsWith('_');
    })
    .sort((a, b) => {
        const dateA = new Date(a.frontmatter.publishDate);
        const dateB = new Date(b.frontmatter.publishDate);
        return dateB.getTime() - dateA.getTime();
    });

// Get unique categories and tags
const categories = [...new Set(posts.map(post => post.frontmatter.category).filter(Boolean))];
const allTags = posts.flatMap(post => post.frontmatter.tags || []);
const uniqueTags = [...new Set(allTags)];

// Get featured posts
const featuredPosts = posts.filter(post => post.frontmatter.featured);
---

<Layout
    title="Blog | Mohamed Boukri - AI, Blockchain & Industrial Engineering Insights"
    description="Explore articles about artificial intelligence, blockchain technology, industrial engineering, data analysis, and optimization. Practical insights and tutorials from a Data & AI specialist."
    ogType="website"
>
    <div class="container mx-auto px-4">
        <Header />
    </div>
    <div class="container mx-auto px-4 py-8 max-w-6xl">
        <!-- Back to Home -->
        <div class="mb-8">
            <Button variant="ghost" size="sm" asChild>
                <a href="/" class="flex items-center text-muted-foreground hover:text-primary">
                    <Icon name="lucide:home" class="w-4 h-4 mr-2" />
                    Back to Home
                </a>
            </Button>
        </div>

        <!-- Hero Section -->
        <header class="text-center mb-16">
            <div class="inline-block mb-4">
                <Badge variant="secondary" className="text-sm px-4 py-2">
                    <Icon name="lucide:book-open" class="w-4 h-4 mr-2 inline" />
                    Blog & Insights
                </Badge>
            </div>
            <h1 class="text-5xl md:text-6xl font-bold text-foreground font-alt mb-6">
                Thoughts on AI, Blockchain & Industry 4.0
            </h1>
            <p class="text-xl text-muted-foreground max-w-3xl mx-auto leading-relaxed">
                Exploring the intersection of artificial intelligence, blockchain technology, and industrial engineering.
                Practical insights, tutorials, and case studies.
            </p>
        </header>

        <Separator className="mb-12" />

        <!-- Featured Posts Section -->
        {featuredPosts.length > 0 && (
            <section class="mb-16">
                <h2 class="text-3xl font-bold text-foreground font-alt mb-8 flex items-center gap-3">
                    <Icon name="lucide:star" class="w-7 h-7 text-primary" />
                    Featured Articles
                </h2>
                <div class="grid md:grid-cols-2 gap-8">
                    {featuredPosts.slice(0, 2).map(post => (
                        <Card className="overflow-hidden hover:shadow-xl transition-all duration-300 group">
                            <a href={post.url} class="block">
                                {post.frontmatter.heroImage && (
                                    <div class="overflow-hidden">
                                        {typeof post.frontmatter.heroImage === 'string' ? (
                                            <img
                                                src={post.frontmatter.heroImage}
                                                alt={post.frontmatter.heroImageAlt || post.frontmatter.title}
                                                class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-300"
                                            />
                                        ) : (
                                            <Image
                                                src={post.frontmatter.heroImage}
                                                alt={post.frontmatter.heroImageAlt || post.frontmatter.title}
                                                width={600}
                                                height={400}
                                                class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-300"
                                            />
                                        )}
                                    </div>
                                )}
                                <CardHeader>
                                    {post.frontmatter.category && (
                                        <Badge variant="secondary" className="mb-3 w-fit">
                                            {post.frontmatter.category}
                                        </Badge>
                                    )}
                                    <CardTitle className="text-2xl font-alt group-hover:text-primary transition-colors">
                                        {post.frontmatter.title}
                                    </CardTitle>
                                    <CardDescription className="text-base mt-2">
                                        {post.frontmatter.description}
                                    </CardDescription>
                                </CardHeader>
                                <CardFooter className="flex items-center justify-between text-sm text-muted-foreground">
                                    <div class="flex items-center gap-2">
                                        <Icon name="lucide:calendar" class="w-4 h-4" />
                                        <time datetime={post.frontmatter.publishDate}>
                                            {new Date(post.frontmatter.publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                                        </time>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <Icon name="lucide:clock" class="w-4 h-4" />
                                        <span>{post.frontmatter.readingTime || '5 min read'}</span>
                                    </div>
                                </CardFooter>
                            </a>
                        </Card>
                    ))}
                </div>
            </section>
        )}

        <!-- All Posts Section -->
        <section>
            <h2 class="text-3xl font-bold text-foreground font-alt mb-8">
                All Articles
            </h2>

            <!-- Filter Section -->
            <div class="mb-8">
                <div class="flex flex-wrap gap-3 items-center mb-6">
                    <span class="text-sm font-semibold text-muted-foreground">Filter by:</span>
                    <button data-filter="all" class="filter-btn active px-4 py-2 rounded-full text-sm font-medium transition-all bg-primary text-primary-foreground">
                        All ({posts.length})
                    </button>
                    {categories.map(category => {
                        const count = posts.filter(post => post.frontmatter.category === category).length;
                        return (
                            <button data-filter={category} class="filter-btn px-4 py-2 rounded-full text-sm font-medium transition-all bg-muted text-foreground hover:bg-muted/80">
                                {category} ({count})
                            </button>
                        );
                    })}
                </div>

                <!-- Search Bar -->
                <div class="relative max-w-md">
                    <Icon name="lucide:search" class="absolute left-3 top-1/2 transform -translate-y-1/2 w-5 h-5 text-muted-foreground" />
                    <input
                        type="text"
                        id="search-input"
                        placeholder="Search articles..."
                        class="w-full pl-10 pr-4 py-3 rounded-lg border border-border bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary"
                    />
                </div>
            </div>

            <div id="posts-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                {posts.map(post => (
                    <div
                        class="post-card"
                        data-category={post.frontmatter.category}
                        data-tags={JSON.stringify(post.frontmatter.tags || [])}
                        data-title={post.frontmatter.title.toLowerCase()}
                        data-description={post.frontmatter.description.toLowerCase()}
                    >
                    <Card
                        class="overflow-hidden hover:shadow-xl transition-all duration-300 group flex flex-col h-full"
                    >
                        <a href={post.url} class="block flex-1 flex flex-col">
                            {post.frontmatter.heroImage && (
                                <div class="overflow-hidden">
                                    {typeof post.frontmatter.heroImage === 'string' ? (
                                        <img
                                            src={post.frontmatter.heroImage}
                                            alt={post.frontmatter.heroImageAlt || post.frontmatter.title}
                                            class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300"
                                        />
                                    ) : (
                                        <Image
                                            src={post.frontmatter.heroImage}
                                            alt={post.frontmatter.heroImageAlt || post.frontmatter.title}
                                            width={400}
                                            height={250}
                                            class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300"
                                        />
                                    )}
                                </div>
                            )}
                            <CardHeader class="flex-1">
                                {post.frontmatter.category && (
                                    <Badge variant="secondary" className="mb-3 w-fit">
                                        {post.frontmatter.category}
                                    </Badge>
                                )}
                                <CardTitle className="text-xl font-alt group-hover:text-primary transition-colors line-clamp-2">
                                    {post.frontmatter.title}
                                </CardTitle>
                                <CardDescription className="mt-2 line-clamp-3">
                                    {post.frontmatter.description}
                                </CardDescription>
                            </CardHeader>
                            <CardFooter className="flex flex-col gap-3">
                                {post.frontmatter.tags && post.frontmatter.tags.length > 0 && (
                                    <div class="flex flex-wrap gap-1 w-full">
                                        {post.frontmatter.tags.slice(0, 3).map((tag: string) => (
                                            <Badge variant="outline" className="text-xs">
                                                #{tag}
                                            </Badge>
                                        ))}
                                    </div>
                                )}
                                <div class="flex items-center justify-between text-sm text-muted-foreground w-full">
                                    <div class="flex items-center gap-2">
                                        <Icon name="lucide:calendar" class="w-4 h-4" />
                                        <time datetime={post.frontmatter.publishDate}>
                                            {new Date(post.frontmatter.publishDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                                        </time>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <Icon name="lucide:clock" class="w-4 h-4" />
                                        <span>{post.frontmatter.readingTime || '5 min'}</span>
                                    </div>
                                </div>
                            </CardFooter>
                        </a>
                    </Card>
                    </div>
                ))}
            </div>

            <!-- No Results Message -->
            <div id="no-results" class="hidden text-center py-16">
                <Icon name="lucide:search-x" class="w-16 h-16 text-muted-foreground mx-auto mb-4" />
                <h3 class="text-2xl font-semibold mb-2">No articles found</h3>
                <p class="text-muted-foreground">Try adjusting your search or filter criteria</p>
            </div>
        </section>

        <!-- Tags Cloud -->
        {uniqueTags.length > 0 && (
            <section class="mt-16 pt-16 border-t border-border">
                <h2 class="text-3xl font-bold text-foreground font-alt mb-8 text-center">
                    Popular Topics
                </h2>
                <div class="flex flex-wrap gap-3 justify-center">
                    {uniqueTags.map(tag => {
                        const count = allTags.filter(t => t === tag).length;
                        return (
                            <button
                                class="tag-filter px-4 py-2 rounded-full text-sm font-medium transition-all bg-muted text-foreground hover:bg-primary hover:text-primary-foreground"
                                data-tag={tag}
                            >
                                #{tag} ({count})
                            </button>
                        );
                    })}
                </div>
            </section>
        )}
    </div>
    <Footer client:load />
</Layout>

<script>
    function initBlogFilters() {
        const filterButtons = document.querySelectorAll('.filter-btn');
        const tagButtons = document.querySelectorAll('.tag-filter');
        const searchInput = document.getElementById('search-input') as HTMLInputElement;
        const postCards = document.querySelectorAll('.post-card');
        const noResults = document.getElementById('no-results');

        let currentCategory = 'all';
        let currentTag = '';
        let searchQuery = '';

        function filterPosts() {
            let visibleCount = 0;

            postCards.forEach(card => {
                const element = card as HTMLElement;
                const category = element.dataset.category || '';
                const tags = JSON.parse(element.dataset.tags || '[]');
                const title = element.dataset.title || '';
                const description = element.dataset.description || '';

                const categoryMatch = currentCategory === 'all' || category === currentCategory;
                const tagMatch = !currentTag || tags.includes(currentTag);
                const searchMatch = !searchQuery ||
                    title.includes(searchQuery) ||
                    description.includes(searchQuery) ||
                    tags.some((tag: string) => tag.toLowerCase().includes(searchQuery));

                if (categoryMatch && tagMatch && searchMatch) {
                    element.classList.remove('hidden');
                    visibleCount++;
                } else {
                    element.classList.add('hidden');
                }
            });

            if (noResults) {
                if (visibleCount === 0) {
                    noResults.classList.remove('hidden');
                } else {
                    noResults.classList.add('hidden');
                }
            }
        }

        // Category filters
        filterButtons.forEach(button => {
            button.addEventListener('click', () => {
                filterButtons.forEach(btn => {
                    btn.classList.remove('active', 'bg-primary', 'text-primary-foreground');
                    btn.classList.add('bg-muted', 'text-foreground');
                });

                button.classList.add('active', 'bg-primary', 'text-primary-foreground');
                button.classList.remove('bg-muted', 'text-foreground');

                const btnElement = button as HTMLElement;
                currentCategory = btnElement.dataset.filter || 'all';
                currentTag = '';
                filterPosts();

                // Reset tag filters
                tagButtons.forEach(tagBtn => {
                    tagBtn.classList.remove('bg-primary', 'text-primary-foreground');
                    tagBtn.classList.add('bg-muted', 'text-foreground');
                });
            });
        });

        // Tag filters
        tagButtons.forEach(button => {
            button.addEventListener('click', () => {
                const btnElement = button as HTMLElement;
                const tag = btnElement.dataset.tag || '';

                if (currentTag === tag) {
                    // Deselect
                    currentTag = '';
                    button.classList.remove('bg-primary', 'text-primary-foreground');
                    button.classList.add('bg-muted', 'text-foreground');
                } else {
                    // Select new tag
                    tagButtons.forEach(btn => {
                        btn.classList.remove('bg-primary', 'text-primary-foreground');
                        btn.classList.add('bg-muted', 'text-foreground');
                    });

                    currentTag = tag;
                    button.classList.add('bg-primary', 'text-primary-foreground');
                    button.classList.remove('bg-muted', 'text-foreground');

                    // Reset category to all
                    currentCategory = 'all';
                    filterButtons.forEach(btn => {
                        btn.classList.remove('active', 'bg-primary', 'text-primary-foreground');
                        btn.classList.add('bg-muted', 'text-foreground');
                    });
                    const allBtn = document.querySelector('[data-filter="all"]');
                    if (allBtn) {
                        allBtn.classList.add('active', 'bg-primary', 'text-primary-foreground');
                        allBtn.classList.remove('bg-muted', 'text-foreground');
                    }
                }

                filterPosts();
            });
        });

        // Search filter
        if (searchInput) {
            searchInput.addEventListener('input', (e) => {
                searchQuery = (e.target as HTMLInputElement).value.toLowerCase();
                filterPosts();
            });
        }
    }

    // Initialize on page load
    initBlogFilters();

    // Reinitialize after Astro transitions
    document.addEventListener('astro:page-load', initBlogFilters);
</script>

<style>
    .post-card {
        transition: all 0.3s ease;
    }

    .post-card.hidden {
        display: none;
    }

    .filter-btn, .tag-filter {
        cursor: pointer;
    }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
