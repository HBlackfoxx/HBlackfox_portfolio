---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import { Icon } from 'astro-icon/components';

export async function getStaticPaths() {
  const allPosts = await Astro.glob('../../*.mdx');
  const validPosts = allPosts.filter(post => {
      const filename = post.file.split(/[/\\]/).pop();
      return !post.frontmatter.draft && !filename?.startsWith('_');
  });
  
  // Get unique tags
  const allTags = validPosts.map((post) => post.frontmatter.tags).flat().filter(Boolean);
  const uniqueTags = [...new Set(allTags)];

  return uniqueTags.map((tag) => {
    const filteredPosts = validPosts.filter((post) => post.frontmatter.tags?.includes(tag));
    // Simple slugify for tag
    const slug = tag.toLowerCase().replace(/ /g, '-').replace(/[^\w-]+/g, '');
    return {
      params: { tag: slug },
      props: { posts: filteredPosts, tag },
    };
  });
}

const { tag, posts } = Astro.props;

// Sort posts by date
const sortedPosts = posts.sort((a, b) => 
  new Date(b.frontmatter.publishDate).valueOf() - new Date(a.frontmatter.publishDate).valueOf()
);
---

<BlogLayout title={`Tag: ${tag}`} description={`Blog posts tagged with ${tag}`}>
  <div class="container mx-auto px-4 py-12">
    <header class="mb-12 text-center">
      <div class="inline-flex items-center justify-center p-3 rounded-full bg-primary/10 mb-4">
        <Icon name="lucide:tag" class="w-8 h-8 text-primary" />
      </div>
      <h1 class="text-4xl font-bold mb-4 font-alt">Tag: #{tag}</h1>
      <p class="text-muted-foreground">Found {posts.length} articles</p>
    </header>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {sortedPosts.map((post) => (
        <a href={post.url} class="group block h-full bg-card border border-border rounded-2xl overflow-hidden hover:border-primary hover:shadow-lg transition-all duration-300">
          {post.frontmatter.heroImage && (
            <div class="aspect-video overflow-hidden">
              <img 
                src={post.frontmatter.heroImage} 
                alt={post.frontmatter.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
          )}
          <div class="p-6">
            <div class="flex items-center gap-2 text-xs text-muted-foreground mb-3">
              {post.frontmatter.category && (
                <span class="bg-secondary text-secondary-foreground px-2 py-0.5 rounded-full">
                  {post.frontmatter.category}
                </span>
              )}
              <time datetime={post.frontmatter.publishDate}>
                {new Date(post.frontmatter.publishDate).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </time>
            </div>
            <h2 class="text-xl font-bold mb-3 group-hover:text-primary transition-colors line-clamp-2">
              {post.frontmatter.title}
            </h2>
            <p class="text-muted-foreground text-sm line-clamp-3">
              {post.frontmatter.description}
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
</BlogLayout>
